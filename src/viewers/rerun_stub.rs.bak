//! Stub for Rerun viewer when feature "rerun-viewer" is disabled.
//! 
//! This provides a no-op implementation to maintain API compatibility
//! while avoiding the ~30% IR bloat from rerun dependencies.

use crate::datasets::config::VisualizationConfig;
use crate::types::{Array3, Float, Matrix3x3, Matrix4x4};
use crate::Result;
use super::Viewer;

/// Stub RerunViewer (no-op when feature disabled)
pub struct RerunViewer;

impl RerunViewer {
    /// Create a new RerunViewer stub
    pub fn new() -> Self {
        log::debug!("[RerunViewer] Stub mode - rerun-viewer feature not enabled");
        Self
    }
    use crate::datasets::config::VisualizationConfig;
    use crate::types::Matrix4x4;
    use crate::Result;
    use super::Viewer;
        log::debug!("[RerunViewer] Stub mode - rerun-viewer feature not enabled");
        Self
    }

impl Default for RerunViewer {
    fn default() -> Self {
        Self::new()
    }
}

}

impl RerunViewer {
    pub fn new() -> Self { Self }
    pub fn new_with_config(_: &VisualizationConfig) -> Self { Self }
impl Viewer for RerunViewer {
    fn initialize(&mut self) -> Result<()> {
        log::debug!("[RerunViewer] Stub: initialize() is no-op");
        Ok(())
    }

    fn log_pose(&mut self, _t_w_b: Matrix4x4, _entity_path: &str) {
        // No-op
    }

    fn log_image_raw(&mut self, _image: &[u8], _width: u32, _height: u32, _entity_path: &str) {
        // No-op
    }

    fn log_image_equalized(&mut self, _image: &[u8], _width: u32, _height: u32, _entity_path: &str) {
        // No-op
    }

    fn log_image_with_features(&mut self, _image: &[u8], _width: u32, _height: u32, _features: &[[f32; 2]], _entity_path: &str) {
        // No-op
    }

    fn log_image_with_features_colored(&mut self, _image: &[u8], _width: u32, _height: u32, _features: &[(usize, [f32; 2])], _entity_path: &str) {
        // No-op
    }

    fn log_points(&mut self, _points: &[[f32; 3]], _entity_path: &str) {
        // No-op
    }

    fn log_points_colored(&mut self, _points: &[(usize, [f32; 3])], _entity_path: &str) {
        // No-op
    }

    fn set_frame(&mut self, _frame_id: i64) {
        // No-op
    }

    fn log_camera_frustum(&mut self, _focal_length: f32, _width: u32, _height: u32, _entity_path: &str, _size: f32) {
        // No-op
    }

    fn log_trajectory(&mut self, _trajectory: &[Matrix4x4], _entity_path: &str) {
        // No-op
    }
}

pub fn create_viewer(config: &VisualizationConfig) -> Result<Box<dyn Viewer>> {
    Ok(Box::new(RerunViewer::new_with_config(config)))
}

